{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "series_count": {
      "type": "integer",
      "minimum": 0
    },
    "live_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "adjusted_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "rating_before": {
      "type": [
        "number",
        "null"
      ]
    },
    "rating_after": {
      "type": [
        "number",
        "null"
      ]
    },
    "rank_before": {
      "type": [
        "integer",
        "null"
      ]
    },
    "rank_after": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reliability_failures": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "type": "string",
      "enum": [
        "keep_observing",
        "promote",
        "rollback",
        "insufficient_data"
      ]
    },
    "reason": {
      "type": "string"
    },
    "match_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "series_count",
    "live_score",
    "adjusted_score",
    "rating_before",
    "rating_after",
    "rank_before",
    "rank_after",
    "reliability_failures",
    "decision",
    "reason",
    "match_ids",
    "evidence_paths"
  ],
  "additionalProperties": false
}
